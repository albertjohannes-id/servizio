{
  "expo": {
    "name": "Servizio",
    "slug": "servizio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F6F5"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Attach receipt or service-tag photos to service logs.",
        "NSCameraUsageDescription": "Photograph workshop service tags to log service dates."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F6B4C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Servizio to attach receipt and service-tag photos.",
          "cameraPermission": "Allow Servizio to photograph workshop service tags."
        }
      ],
      "expo-notifications"
    ]
  }
}
